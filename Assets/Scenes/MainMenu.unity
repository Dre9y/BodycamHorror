  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BodycamHorror.UI.MainMenu
  title: BLOCK 13
  startLabel: "\u0418\u0413\u0420\u0410\u0422\u042C"
  settingsLabel: "\u041D\u0410\u0421\u0422\u0420\u041E\u0419\u041A\u0418"
  exitLabel: "\u0412\u042B\u0425\u041E\u0414"
  backLabel: "\u041D\u0410\u0417\u0410\u0414"
  titleFont: {fileID: 12800000, guid: 79a35895686b5344a9a3fbdf356bec88, type: 3}
  itemFont: {fileID: 12800000, guid: d3a1d59d392565b4083aaa2f994a3552, type: 3}
  columnX: 0.64
  titleY: 0.16
  itemsY: 0.33
  itemGap: 0.155
  firstScene: Level
  sceneFadeIn: 3
  textFadeTime: 1.6
  musicFadeTime: 2.2
  lore: "\u0411\u043B\u043E\u043A 13.\n\u0414\u0435\u0432\u044F\u0442\u0438\u044D\u0442\u0430\u0436\u043D\u0430\u044F \u043F\u0430\u043D\u0435\u043B\u044C\u043A\u0430 \u043D\u0430 \u043E\u043A\u0440\u0430\u0438\u043D\u0435 \u0433\u043E\u0440\u043E\u0434\u0430.\n\n\u0423\u0436\u0435 \u043D\u0435\u0434\u0435\u043B\u044E \u043E\u0442\u0442\u0443\u0434\u0430 \u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u044E\u0442 \u0437\u0432\u043E\u043D\u0438\u0442\u044C: \u0437\u0430 \u0441\u0442\u0435\u043D\u0430\u043C\u0438 \u043A\u0440\u0438\u0447\u0430\u0442, \u0441\u0432\u0435\u0442 \u0433\u0430\u0441\u043D\u0435\u0442 \u044D\u0442\u0430\u0436 \u0437\u0430 \u044D\u0442\u0430\u0436\u043E\u043C, \u0436\u0438\u043B\u044C\u0446\u044B \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0434\u0432\u0435\u0440\u0438.\n\n\u0422\u044B \u2014 \u0442\u043E\u0442 \u0441\u0430\u043C\u044B\u0439 \u043F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F.\n\n\u0422\u044B \u043F\u043E\u043C\u043D\u0438\u0448\u044C \u043B\u0435\u0441\u0442\u043D\u0438\u0447\u043D\u0443\u044E \u043A\u043B\u0435\u0442\u043A\u0443. \u0427\u0442\u043E-\u0442\u043E \u0448\u0435\u0432\u0435\u043B\u044C\u043D\u0443\u043B\u043E\u0441\u044C \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435. \u0423\u0434\u0430\u0440 \u043F\u043E \u0433\u043E\u043B\u043E\u0432\u0435.\n\n\u0410 \u043F\u043E\u0442\u043E\u043C \u2014 \u043D\u0438\u0447\u0435\u0433\u043E."
  loreGap: 0.6
  loreFadeIn: 1.5
  loreHold: 10
  loreFadeOut: 1.5
  loreAfter: 0.4
  music: {fileID: 8300000, guid: 8ae20998ebbf87d4382043985e11ebb8, type: 3}
  musicVolume: 0.8
